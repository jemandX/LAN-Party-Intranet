"""LAN-Party-Intranet: liefert index.html aus und speichert den Stand in state.json.

Start:  python server.py
Dann im Browser:  http://<IP-des-Host-PCs>:8080
Benötigt nur Python 3 (keine zusätzlichen Pakete).
"""
import json
import hashlib
import hmac
import os
import queue
import re
import secrets
import socket
import subprocess
import sys
import tempfile
import threading
import time
from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer
from http.cookies import SimpleCookie

PORT = 8080
ROOT = os.path.dirname(os.path.abspath(__file__))
STATE_FILE = os.path.join(ROOT, "state.json")
USERS_FILE = os.path.join(ROOT, "users.json")
MAX_REQUEST_SIZE = 64_000
lock = threading.Lock()
users_lock = threading.Lock()
sessions_lock = threading.Lock()
sessions = {}
login_attempts_lock = threading.Lock()
login_attempts = {}
sound_cooldowns_lock = threading.Lock()
sound_cooldowns = {}
sound_queue = queue.Queue()
SOUNDS_DIR = os.path.join(ROOT, "sounds")
SOUND_MODES = {"name", "sound", "both"}

DEFAULT = {
    "rev": 0,
    "schedule": [
        {"time": "12:00", "title": "Aufwärmen (freies Spiel)"},
        {"time": "13:00", "title": "Hotdog-Pause"},
        {"time": "14:00", "title": "Runde 1"},
        {"time": "15:30", "title": "Pause"},
        {"time": "16:00", "title": "Runde 2"},
        {"time": "17:30", "title": "Finale"},
    ],
    "rounds": 2,
    "players": [
        {"name": "Spieler 1", "scores": [0, 0]},
        {"name": "Spieler 2", "scores": [0, 0]},
        {"name": "Spieler 3", "scores": [0, 0]},
    ],
    "hotdogs": 0,
    "info": "WLAN-Passwort, Server-IPs und Regeln hier eintragen.",
}


def num(x):
    try:
        return int(float(x))
    except Exception:
        return 0


def load():
    try:
        with open(STATE_FILE, encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return json.loads(json.dumps(DEFAULT))


def load_users():
    try:
        with open(USERS_FILE, encoding="utf-8") as f:
            data = json.load(f)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def save_users(users):
    """Schreibt users.json atomar, damit ein Abbruch keine halbe Datei hinterlässt."""
    fd, temp_path = tempfile.mkstemp(prefix="users-", suffix=".tmp", dir=ROOT)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(users, f, ensure_ascii=False, indent=2)
            f.flush()
            os.fsync(f.fileno())
        os.replace(temp_path, USERS_FILE)
    finally:
        if os.path.exists(temp_path):
            os.remove(temp_path)


def username_key(name):
    return name.casefold()


def hash_password(password, salt=None):
    salt = salt or secrets.token_bytes(16)
    digest = hashlib.scrypt(password.encode("utf-8"), salt=salt, n=2**14, r=8, p=1)
    return salt.hex(), digest.hex()


def verify_password(password, user):
    try:
        salt = bytes.fromhex(user["salt"])
        expected = bytes.fromhex(user["password_hash"])
        actual = hashlib.scrypt(password.encode("utf-8"), salt=salt, n=2**14, r=8, p=1)
        return hmac.compare_digest(actual, expected)
    except (KeyError, ValueError, TypeError):
        return False


def public_user(user):
    return {"username": user["username"], "role": user["role"],
            "sound_mode": user.get("sound_mode", "name"),
            "sound_file": user.get("sound_file", "")}


def current_user(handler):
    cookie = SimpleCookie()
    try:
        cookie.load(handler.headers.get("Cookie", ""))
        token = cookie.get("lanparty_session").value if cookie.get("lanparty_session") else ""
    except Exception:
        token = ""
    with sessions_lock:
        session = sessions.get(token)
        if not session:
            return None
        if session["expires"] < time.time():
            sessions.pop(token, None)
            return None
        return session["user"]


def issue_session(user):
    token = secrets.token_urlsafe(32)
    with sessions_lock:
        sessions[token] = {"user": user, "expires": time.time() + 30 * 24 * 60 * 60}
    return token


def require_user(handler):
    user = current_user(handler)
    if user is None:
        handler.send_json(401, {"error": "Bitte zuerst anmelden."})
    return user


def admin_state_change(old, new):
    """Prüft, ob ein Nicht-Admin nur erlaubte Werte verändert hat."""
    return (old.get("schedule") == new.get("schedule")
            and old.get("rounds") == new.get("rounds")
            and old.get("info") == new.get("info")
            and len(old.get("players", [])) == len(new.get("players", []))
            and all(a.get("name") == b.get("name")
                    and len(a.get("scores", [])) == len(b.get("scores", []))
                    for a, b in zip(old.get("players", []), new.get("players", []))))


def available_sounds():
    try:
        return sorted(name for name in os.listdir(SOUNDS_DIR)
                      if name.lower().endswith(".wav")
                      and os.path.isfile(os.path.join(SOUNDS_DIR, name)))
    except OSError:
        return []


def allow_sound(user):
    now = time.time()
    key = username_key(user["username"])
    with sound_cooldowns_lock:
        last = sound_cooldowns.get(key, 0)
        if now - last < 30:
            return False
        sound_cooldowns[key] = now
        return True


def enqueue_sound(user, selected_file=None):
    mode = user.get("sound_mode", "name")
    filename = selected_file if selected_file is not None else user.get("sound_file", "")
    if filename not in available_sounds():
        filename = ""
    sound_queue.put((user["username"], mode, filename))


def play_sound_item(item):
    username, mode, filename = item
    if sys.platform != "win32":
        print("Sound übersprungen: Host ist kein Windows-System.")
        return
    try:
        import winsound
        if mode in ("sound", "both"):
            if filename:
                path = os.path.join(SOUNDS_DIR, filename)
                if os.path.commonpath([SOUNDS_DIR, os.path.abspath(path)]) == SOUNDS_DIR:
                    winsound.PlaySound(path, winsound.SND_FILENAME)
            else:
                for frequency, duration in ((660, 120), (880, 160), (990, 200)):
                    winsound.Beep(frequency, duration)
        if mode in ("name", "both"):
            safe_name = re.sub(r"[^\w .-]", "", username, flags=re.UNICODE)[:20].strip()
            if safe_name:
                script = "$name = [Console]::In.ReadToEnd(); $s = New-Object System.Speech.Synthesis.SpeechSynthesizer; $s.Speak($name)"
                subprocess.run(["powershell.exe", "-NoProfile", "-NonInteractive", "-Command", script],
                               input=safe_name, text=True, timeout=30, check=False,
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception as exc:
        print("Sound-Wiedergabe fehlgeschlagen: " + str(exc))


def sound_worker():
    while True:
        item = sound_queue.get()
        try:
            play_sound_item(item)
        finally:
            sound_queue.task_done()


threading.Thread(target=sound_worker, name="Host-Sound", daemon=True).start()


def clean(d, rev):
    """Prüft und begrenzt die Daten, die ein Browser schickt."""
    return {
        "rev": rev,
        "schedule": [
            {"time": str(x.get("time", ""))[:5], "title": str(x.get("title", ""))[:80]}
            for x in d["schedule"][:50]
        ],
        "rounds": max(1, min(num(d["rounds"]), 20)),
        "players": [
            {
                "name": str(p.get("name", ""))[:30],
                "scores": [num(s) for s in p.get("scores", [])[:20]],
            }
            for p in d["players"][:30]
        ],
        "hotdogs": max(0, min(num(d.get("hotdogs", 0)), 999)),
        "info": str(d.get("info", ""))[:2000],
    }


class Handler(SimpleHTTPRequestHandler):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, directory=ROOT, **kwargs)

    def send_json(self, code, obj):
        body = json.dumps(obj, ensure_ascii=False).encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        if self.path.split("?")[0] == "/api/state":
            with lock:
                return self.send_json(200, load())
        return super().do_GET()

    def do_POST(self):
        if self.path.split("?")[0] != "/api/state":
            return self.send_error(404)
        user = require_user(self)
        if user is None:
            return
        try:
            length = int(self.headers.get("Content-Length", 0))
            if length < 0 or length > MAX_REQUEST_SIZE:
                return self.send_json(413, {"error": "Anfrage ist zu groß."})
            data = json.loads(self.rfile.read(length))
            with lock:
                old = load()
                new = clean(data, old.get("rev", 0) + 1)
                if user["role"] != "admin" and not admin_state_change(old, new):
                    return self.send_json(403, {"error": "Dafür fehlen die Rechte."})
                with open(STATE_FILE, "w", encoding="utf-8") as f:
                    json.dump(new, f, ensure_ascii=False, indent=2)
            return self.send_json(200, new)
        except Exception:
            return self.send_json(400, {"error": "Ungültige Daten"})

    def log_message(self, *args):
        pass  # keine Konsolenflut


def local_ip():
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("10.255.255.255", 1))
        ip = s.getsockname()[0]
        s.close()
        return ip
    except Exception:
        return socket.gethostbyname(socket.gethostname())


