    print("LAN-Party-Intranet läuft.")
    print(f"  Auf diesem PC:  http://localhost:{PORT}")
    print(f"  Für alle anderen: http://{local_ip()}:{PORT}")
    print("Beenden mit Strg+C.")
    ThreadingHTTPServer(("0.0.0.0", PORT), Handler).serve_forever()
